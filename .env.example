# Safe defaults (Rule 6). Real execution requires deliberately changing all three healing switches.
DEMO_MODE=true
AUTH_PROVIDER=demo                  # demo | token  (demo is refused when HEALING_EXECUTION_MODE=LIVE)
HEALING_ENABLED=false
HEALING_EXECUTION_MODE=DRY_RUN      # DRY_RUN | LIVE
MAX_HEALING_CYCLES=2
APPROVAL_TTL_MINUTES=60
HIGH_RISK_APPROVALS=2
MAX_TASKS_CLEARED=25
MAX_ACTIONS_PER_DAG_PER_HOUR=2
VERIFY_POLL_SECONDS=10
VERIFY_TIMEOUT_SECONDS=600
RECONCILE_ATTEMPTS=3
RECONCILE_INTERVAL_SECONDS=5
AIRFLOW_API_BASE_URL=
AIRFLOW_API_VERSION=                # set per target Airflow version
AIRFLOW_READ_USERNAME=
AIRFLOW_READ_PASSWORD=
AIRFLOW_READ_TOKEN=
AIRFLOW_WRITE_USERNAME=
AIRFLOW_WRITE_PASSWORD=
AIRFLOW_WRITE_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
WEBHOOK_SECRET=
DATABASE_URL=sqlite:///./triage.db
MAX_LOG_BYTES=200000
MAX_EVIDENCE_BYTES=50000
MAX_LLM_INPUT_TOKENS=50000
NOTIFY_SLACK_WEBHOOK_URL=
ANTHROPIC_FALLBACKS=                # 'off' disables server-side refusal fallbacks
# Phase 5: API / UI / notifications / poller
UI_BASE_URL=http://localhost:8501   # used in notification links (authenticated UI only)
TRIAGE_API_URL=http://localhost:8000  # where the Streamlit UI finds the API
FAKE_AIRFLOW_SCENARIO=hero_transient_network  # DEMO MODE only, when AIRFLOW_API_BASE_URL is empty
POLLER_ENABLED=false
POLL_INTERVAL_SECONDS=60
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USERNAME=
NOTIFY_SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
